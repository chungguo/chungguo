---
import katex from "katex";
import "katex/dist/katex.min.css";

interface Props {
	node: {
		formula?: string;
		display?: boolean;
	};
}

const { node } = Astro.props;
const { formula = "", display = false } = node;

let html = "";
let error = "";

try {
	html = katex.renderToString(formula, {
		displayMode: display,
		throwOnError: false,
		output: "html",
	});
} catch (e) {
	error = String(e);
}
---

{display ? (
	<figure class="math-block math-block--display">
		{error
			? <pre class="math-error">{error}</pre>
			: <Fragment set:html={html} />
		}
	</figure>
) : (
	<span class="math-block math-block--inline">
		{error
			? <code class="math-error">{error}</code>
			: <Fragment set:html={html} />
		}
	</span>
)}
