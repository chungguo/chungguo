{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "chungguo-site",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"cache": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "chungguo-site",
			"migrations_dir": "../../migrations",
			"database_id": "6944fb57-4304-4bb1-b08b-4dab2ef9edb5",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "chungguo-media",
		},
	],
	// Drives scheduled publishing, plugin cron, and maintenance (see src/worker.ts)
	"triggers": {
		"crons": [
			"* * * * *"
		],
	},
}
